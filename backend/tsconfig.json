{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["cms/**/*.ts", "contact/**/*.ts", "content/**/*.ts", "database/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
